@using DotNetNuke.Web.DDRMenu;
@inherits DotNetNuke.Web.Razor.DotNetNukeWebPage<dynamic>

<nav class="__PREFIX__-nav bond-container" aria-label="Main Navigation">
    <ul class="__PREFIX__-nav__list">
        @foreach (var node in Model.Source.root.Children)
        {
            string target = (string)node.Target;
            string targetAttr = string.IsNullOrEmpty(target) ? null : target;
            string relAttr = target == "_blank" ? "noopener" : null;
            <li class="__PREFIX__-nav__item">
                @if (node.Enabled)
                {
                    <a href="@node.Url" target="@targetAttr" rel="@relAttr" class="__PREFIX__-nav__link @(node.Selected ? "is-selected" : "")">@node.Text</a>
                }
                else
                {
                    <span class="__PREFIX__-nav__link __PREFIX__-nav__link--disabled">@node.Text</span>
                }
            </li>
        }
    </ul>
</nav>
