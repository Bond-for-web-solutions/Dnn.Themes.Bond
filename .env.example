# Copy to .env (git-ignored) and point it at YOUR local DNN development sites.
# Only local development sites belong here: bond refuses network paths, folders that are
# not a DNN site, and skin/container folders it did not deploy itself (unless --adopt).
# Never point this at a shared, staging or production server.

# One site per theme: <THEME>_SITE_ROOT, where <THEME> is the folder name in themes/ in
# capitals (bond -> BOND, my-shop -> MY_SHOP). The DNN site root has web.config, bin\ and Portals\.
BOND_SITE_ROOT=C:\DNN\bond-dev
# DZP_SITE_ROOT=C:\DNN\dzp-dev

# Optional, per theme: on each deploy, make the skin/container folder mirror the build by
# deleting every file the build does not have (files added by hand too).
# BOND_PRUNE=true

# Optional fallback for themes without their own line (and the default for PRUNE).
# SITE_ROOT=C:\DNN\my-dev-site
# PRUNE=false
