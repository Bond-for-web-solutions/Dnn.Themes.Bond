    "skinName": "DNN.Themes.DZP",
    "containerPackageName": "DNN.Themes.DZP Containers",
    "containerFriendlyName": "DNN.Themes.DZP Containers",
    "containerDescription": "Containers for the DNN.Themes.DZP theme.",
    "containerName": "DNN.Themes.DZP",
    "coreVersion": "10.00.00",
    "owner": {
      "name": "Bond for web solutions",
      "organization": "Bond for web solutions",
      "url": "https://www.bondforwebsolutions.nl/",
      "email": "TODO-set-before-release@invalid"
    },
    "license": "package/License.txt",
    "releaseNotes": "package/ReleaseNotes.txt"
  },
  "styles": {
    "skin.css": "styles/skin.css",
    "dashboard.css": "styles/layouts/dashboard.css"
